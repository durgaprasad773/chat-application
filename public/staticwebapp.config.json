{
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
  },
  "routes": [
    { "route": "/llms.txt", "headers": { "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "public, max-age=3600" } },
    { "route": "/robots.txt", "headers": { "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "public, max-age=3600" } },
    { "route": "/sitemap.xml", "headers": { "Content-Type": "application/xml; charset=utf-8", "Cache-Control": "public, max-age=3600" } },
    { "route": "/*.png", "headers": { "Cache-Control": "public, max-age=604800" } },
    { "route": "/*.jpg", "headers": { "Cache-Control": "public, max-age=604800" } },
    { "route": "/nsx-attribution.js", "headers": { "Cache-Control": "public, max-age=3600" } },
    { "route": "/index.html", "headers": { "Cache-Control": "public, max-age=300" } }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/index.html", "statusCode": 404 }
  },
  "mimeTypes": { ".txt": "text/plain", ".json": "application/json", ".webmanifest": "application/manifest+json" }
}
